#!/bin/sh
# Rx7 v3 pre-commit — VALIDATES ONLY.
#
# It never writes a file in the tree, never stages anything, never asks for a second commit
# attempt, and never treats an advisory as fatal. The only thing that can stop a
# commit is exit code 1 from `check`, which means the record contradicts itself and
# names the exact rows. Answered-but-unapplied blocks, work still open, stale prose
# cites — all of those are exit code 2 and none of them block anything. Exit code 3
# (a crash or usage error in the tool) and a missing Python are reported and let
# through: a broken checker must never be the reason a commit cannot happen — that
# is the v2 trap this hook exists not to repeat.
#
# It checks WHAT IS BEING COMMITTED - the index - not the working tree (plan P12). On
# 2026-09-25 a file staged from a refused commit went in unseen because the hook read
# the tree, where it had already been fixed. The index is exported to a scratch folder
# (about 15 MB) and checked there.
#
# Install once per clone:  git config core.hooksPath .githooks

PY=""
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
    PY="$cand"; break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no working Python found - the record was NOT checked; committing anyway."
  exit 0
fi

T=$(mktemp -d 2>/dev/null) || T=""
if [ -n "$T" ] && git ls-files -z -- tools '00-CAR/data' '01-REFERENCE/data' '02-APP/data' '02-PROJECTS' '99-ARCHIVE' | git checkout-index -z --prefix="$T/" --stdin 2>/dev/null; then
  "$PY" "$T/tools/rx7.py" check
  rc=$?
  rm -rf "$T"
else
  echo "pre-commit: could not export the index; checking the working tree instead."
  [ -n "$T" ] && rm -rf "$T"
  "$PY" tools/rx7.py check
  rc=$?
fi
if [ "$rc" -eq 1 ]; then
  echo ""
  echo "pre-commit: the record contradicts itself. Fix the rows named above (CLAUDE.md §3);"
  echo "            the hook is never skipped."
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "pre-commit: rx7.py check exited $rc (not 1) - not a verdict on the record; committing."
fi
exit 0
