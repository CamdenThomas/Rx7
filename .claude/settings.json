{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "python tools/hook_check.py"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python tools/hook_stop.py"}]
      }
    ]
  }
}
