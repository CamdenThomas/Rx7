	(text "J1 - FROM THE BT817 BOARD'S CN1 (ME817EV, S-500 Table 3-3)" (exclude_from_sim no) (at 12.7 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "f65885c9-7071-5e05-ad2a-e12d07c1c0bd"))
	(text "J1 pin k = CN1 pin 51-k: a 50-way 0.5 mm FFC, contacts on the same side (type A), the two bottom-contact connectors mouth to mouth." (exclude_from_sim no) (at 12.7 22.86 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "51b60931-32ac-5cd6-8cec-92671f9923e8"))
	(text "Nets named by CN1: R7-R0 = CN1 28-35, G7-G0 = 20-27, B7-B0 = 12-19, DE 9, VS 10, HS 11, DCLK 37, DISP 44, GND 5 / 36 / 38 / 48. LEDA / LEDK, DVDD, VCOM, VGH / VGL / AVDD left open." (exclude_from_sim no) (at 12.7 26.67 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "09031056-afa8-59f4-93af-417feea74bc8"))
	(text "U1 - TFP410, SET BY ITS PINS (TI SLDS145D)" (exclude_from_sim no) (at 91.44 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "5ada387a-0348-5a93-9c75-cab853e474fd"))
	(text "ISEL low (no I2C), BSEL high (24-bit single edge), VREF = DVDD (3.3 V CMOS), DKEN low, EDGE high = rising edge (JP1 closed = falling)." (exclude_from_sim no) (at 91.44 22.86 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "cf34628e-8e85-59ef-a5cf-776795d044d3"))
	(text "DATA[23:16] red, [15:8] green, [7:0] blue (Table 6-2); IDCK+ the clock, IDCK- to ground (single-ended); TFADJ 510 ohm to TVDD." (exclude_from_sim no) (at 91.44 26.67 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "82f5de46-8db2-5cc4-b083-d89a72aae65d"))
	(text "J2 - DVI ON AN HDMI SOCKET" (exclude_from_sim no) (at 167.64 60.96 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "866e4c07-dc85-5bbe-8ae3-f0f29d6baaea"))
	(text "TMDS straight to the socket, the sink terminates (DC-coupled). No DDC: SCL / SDA / CEC open. +5V on pin 18, HPD to TP3." (exclude_from_sim no) (at 167.64 66.04 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9c8b2329-5d19-59e3-acf3-7a8e5e2e9c3e"))
	(text "POWER: 5 V ON J3, 3.3 V FROM U2" (exclude_from_sim no) (at 12.7 134.62 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "534ee130-a04b-51ab-b2e8-746a968dd317"))
	(text "About 0.1 A at 3.3 V for the TFP410 at a 100 MHz pixel clock; where the 5 V comes from in the Display Unit is not drawn yet (confirm)." (exclude_from_sim no) (at 12.7 139.7 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "11c2ae95-993e-5b24-920b-32df32d3e5a2"))
