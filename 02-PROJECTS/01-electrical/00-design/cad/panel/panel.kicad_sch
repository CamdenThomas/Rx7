	(text "SCREEN  -  a 128 x 64-class I2C module on the panel bus (P201, D-492)" (exclude_from_sim no) (at 455 22 0) (effects (font (size 3.2 3.2) (bold yes)) (justify left top)) (uuid "2c268448-6031-4bf9-a54e-7639ad346b76"))
	(text "J2 takes the module's own 4-pin header, GND - VCC - SCL - SDA (the common order, confirm on the module bought)." (exclude_from_sim no) (at 455 30 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "727b733a-ce9f-4835-a0bd-7fb3cc5b808d"))
	(text "JP1 picks its supply: 1-2 +5V_PNL (the record: +3V3 feeds only the stick) or 2-3 +3V3. A module whose I2C pull-ups go" (exclude_from_sim no) (at 455 34 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "040451a6-0b50-4fbc-9054-9e8f76a9c77a"))
	(text "to its VCC must not run at 5 V on this bus (the Teensy's pins are 3.3 V): bridge 2-3 or remove them - confirm (P201)." (exclude_from_sim no) (at 455 38 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "2eef60d7-995e-4e81-858d-7268d79e0b74"))
