	(text "LIGHT DRIVER (D-458, D-462)" (exclude_from_sim no) (at 428 93 0) (effects (font (size 3.0 3.0) (bold yes)) (justify left top)) (uuid "6f03e105-384d-4abb-86cc-15d5dee12993"))
	(text "IS31FL3236A-TQLS4 (eTQFP-48, -40 to +125 C) on the back, I2C 0x3C (AD to GND), on the DCU's bus:" (exclude_from_sim no) (at 429 99.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "d6e1ec4b-fdfe-48a8-ae2d-5bd361319b93"))
	(text "0x74 / 0x75 (expanders, SN17) and 0x48 (ADC, SN29) are the carrier's. +5V_PNL from ribbon pin 26 (PTC F1 on the carrier)." (exclude_from_sim no) (at 429 103.1 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "634ae5d9-a42d-46c5-9f18-0b3e8212e65a"))
	(text "One channel per LED; R1 10k sets IMAX = 58.5 x 1.3 V / 10k = 7.6 mA (p.11); 256 PWM steps per channel." (exclude_from_sim no) (at 429 106.7 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "cf292d28-9f25-4b50-89f4-27cf1d739775"))
	(text "Dimming (D-462): the DCU scales every channel's PWM to the dash dimmer level and writes the update register 25h;" (exclude_from_sim no) (at 429 110.3 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "b6b3b242-9b84-4732-807b-9c8d47928c12"))
	(text "22 kHz PWM (register 4Bh) keeps the ceramic caps silent (p.12). SDB held high by R2: powers up blank (p.9)." (exclude_from_sim no) (at 429 113.9 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "eca98cf5-a5bb-4762-85e8-ab3bbf99fb1c"))
	(text "OUT1-9 keys in 0x400 bit order, OUT10-16 fan, OUT17-23 temperature, OUT24-29 driver seat, OUT30-35 passenger seat, OUT36 open." (exclude_from_sim no) (at 429 117.5 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "a91f1948-8c11-4d10-956c-e59762306f19"))
