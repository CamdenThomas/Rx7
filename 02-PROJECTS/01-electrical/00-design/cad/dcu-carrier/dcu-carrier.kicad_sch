	(rectangle (start 580 130.5) (end 1040 162.5) (stroke (width 0.2032) (type dash)) (fill (type none)) (uuid "d5b95388-08f1-46c9-bd2e-70f05d27b3c2"))
	(text "WHAT THIS SHEET DOES NOT KNOW (R11)" (exclude_from_sim no) (at 584 174.5 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "ad91e736-6940-4b09-ad3a-4fa958f3e236"))
	(text "- Module pin numbers are now the datasheets' (cad/pin_tables.csv, check.py); every footprint is stock KiCad or drawn from the vendor drawing - confirm against the parts in hand (R11)." (exclude_from_sim no) (at 584 179 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "e93e1a34-5f8d-4525-9c42-a66e6508e359"))
	(text "- The mirror heads: motor and clutch pins, stall current, clutch return (luxury W-332). IPROPI resistor and D-360 wait on it." (exclude_from_sim no) (at 584 183.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "cacf5bbe-7b6b-4244-ae80-88c0cd4123cd"))
	(text "- TPS54560B compensation, RT and inductor: proposals from the datasheet method, not checked in WEBENCH." (exclude_from_sim no) (at 584 188 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "754c1944-8c9e-4533-a907-6fcbc6971069"))
	(text "- DRV8962: charge-pump, DVDD and VCC bypass per TI table 6-1; RIPROPI 1.5k x4 puts ITRIP near 10 A (VREF 3.3 V, 212 uA/A) - confirm vs stall (W-332)." (exclude_from_sim no) (at 584 192.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "d6e66526-6561-495d-a266-214800c56fae"))
	(text "- BTS3011TE STATUS x4 wired-OR to U13 P00 with one 10k pull-up: a latched thermal fault reads low; clearing it needs P00 driven high (3-7 mA per faulted part) with IN low - confirm the expander's drive." (exclude_from_sim no) (at 584 197 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "bd8c585d-05fa-4838-8fb7-369769763bf9"))
	(text "- The wake strip input level: drawn as a 12 V high-side source into a diode-OR strip (D-350); SN21 still confirm." (exclude_from_sim no) (at 584 201.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9f9a103e-8f16-4afe-95fc-7138a6c8dc6a"))
	(text "- Window coil current (K5-K8) and the logic-12 V budget on F22 3 A: 2 coils + one mirror + logic is about 2.2 A." (exclude_from_sim no) (at 584 206 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "dfcd485c-5163-457f-bc2a-dafebd271bae"))
	(text "- The two PROFET IS lines (U9, U10) are not read: all 42 Teensy edge pins are used. Diagnostics stay off (DEN low), and so on the clutch stage U14 (Y11)." (exclude_from_sim no) (at 584 210.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "1fabc9fc-b1f2-4ef2-918e-bfee3eecc977"))
	(text "- The enclosure: V-102 is unmeasured, so the board outline is PROVISIONAL (180 x 80 mm, four M3; sized by the three DT13 flanges) - confirm." (exclude_from_sim no) (at 584 215 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "39659fea-8b0d-491b-bd95-903a275ea660"))
	(text "NO-CONNECTS: TPS54560B EN floats high on its internal pull-up; U13 P03-P17 and U15 ALERT/RDY are unused. DP-DCU-B 12 (AC_CLUTCH) and DP-DCU-C 8 (PGND) are wired for blocks 02.15 / 01.26 (Y11)." (exclude_from_sim no) (at 584 219.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "5bbf49f9-be18-4bc0-a69a-881165281124"))
