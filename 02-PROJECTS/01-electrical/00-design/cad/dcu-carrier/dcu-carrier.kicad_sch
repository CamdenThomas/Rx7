	(label "SEAT_STATUS" (at 66.04 443.23 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "ecb65404-9b46-4e9c-b104-9f01b2345bb9"))
	(rectangle (start 580 236) (end 1040 486) (stroke (width 0.2032) (type dash)) (fill (type none)) (uuid "63c22e94-e977-4f2a-b621-a2db14302ca9"))
	(text "PROVISIONS (Y11) - the open blocks' worst case, drawn in so an answer is a fitting change, not a redesign (D-455)" (exclude_from_sim no) (at 583 239 0) (effects (font (size 3.2 3.2) (bold yes)) (justify left top)) (uuid "e6ef56ad-6742-43df-af2a-a64ff6d7780b"))
	(text "U13  second expander TCA9539-Q1 at 0x75 (A0 high, A1 low) - FITTED: P00 SEAT_STATUS (moved from U12 P17), P01 the radar alert" (exclude_from_sim no) (at 584 249 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left top)) (uuid "60beb369-3e2b-4d14-a18d-fad5955b92d3"))
	(text "Same I2C bus as U12 (R51 / R52). INT wired-OR on EXP_INT (both open-drain, one pull-up R53, Teensy 12); RESET shared on EXP_RESET (R54 holds both in reset):" (exclude_from_sim no) (at 584 253.5 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9540f7a0-67ba-40e3-9d87-24024f8f8b03"))
	(text "one pin left on the Teensy for neither, and a reset must leave every output stage off on both expanders at once. P02-P17 unused: firmware sets them outputs, low." (exclude_from_sim no) (at 584 257 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "e5b4d0d6-bf9a-4ef0-86c3-98a45770d46b"))
