	)
	(text "IC16. Out: 0x200, 0x210, 0x218, and the battery frames 0x220 / 0x221 (D-345).\nIn: 0x180 extended, 29-bit big-endian, from the AEM wideband (D-266)."
		(exclude_from_sim no)
		(at 398.78 99.06 0)
		(effects
