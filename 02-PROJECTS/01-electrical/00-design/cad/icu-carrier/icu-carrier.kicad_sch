	)
	(text "Every channel ends in the same three parts and every one is drawn: series or divider resistor, 100 nF, BAT54S to +3V3 and GND.\nNone of them is abbreviated or hidden behind a symbol, because the whole point of drawing this is that a missing clamp is visible."
		(exclude_from_sim no)
		(at 10.16 210.82 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "84d64f39-21bd-4699-86b9-e94d9ca1b978")
	)
