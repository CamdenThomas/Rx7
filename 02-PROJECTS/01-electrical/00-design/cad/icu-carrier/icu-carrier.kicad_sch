		(uuid "8f97fc83-e41c-4d04-8bdb-da6d628e6f47")
	)
	(text "6 / 31.5 / 80 ohm, re-read in the car (D-249, D-261)"
		(exclude_from_sim no)
		(at 260.35 224.79 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "909b1348-f69a-4645-be9b-8fb50f9f7c0c")
	)
	(text "The Teensy is drawn as the SOCKET it plugs into and nothing more.\n\nThe reason is R11 and CONVENTIONS section 2.8: the record assigns no\nTeensy pin numbers anywhere. icu_channels says 'ADC', 'digital, input\ncapture', 'QSPI header', 'I2C', 'Serial2 + 2 GPIO' - and stops. Drawing\na pinout would put facts on this sheet that the record does not have,\nand a schematic that quietly picks an answer is worse than one with a\nquestion mark on it. The pin numbers below are ordinal: they say which\nnets reach the socket, not where.\n\nThe 8 MB PSRAM (APS6404L-3SQR) is not on this sheet either - it solders\nto the Teensy's own underside pads, not to the carrier.\n\nPin assignment happens with the layout (F2) and the firmware. When it\ndoes it becomes a row in the record first, and a wire here second."
		(exclude_from_sim no)
		(at 1018.54 137.16 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "93b7e7c2-1a81-4e31-bb4c-40c67506a08a")
	)
	(text "5  CAN2 L"
		(exclude_from_sim no)
		(at 8.89 72.136 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "9486f220-eae6-40cc-893c-cfe48ac4de41")
	)
	(text "IC08  road speed - DP-ICU-B 8"
		(exclude_from_sim no)
		(at 304.8 389.89 0)
		(effects
			(font
