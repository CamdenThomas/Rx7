{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Rx7 window may use: its own events, its settings store, opening a web link, and GitHub (the phone's way to the record).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://raw.githubusercontent.com/*" }
      ]
    }
  ]
}
