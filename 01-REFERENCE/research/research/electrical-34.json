  {
   "id": "PT708",
   "link": "https://www.atkinsrotary.com/81-83-Rx7-Ignition-Switch-BA24-66-155A.html",
   "support": "",
   "cad": "",
   "note_add": "S-001: WR in (1.25 sq main link), ACC out L, IG out BY, ST out via 0.5 sq fusible link to BY (inhibitor switch, A/T). BA24-66-155A is NLA at Atkins; BA14-66-151A suggested as substitute; forum says the 84-85 switch fits with one extra wire and different plug colours."
  },
  {
   "id": "PT709",
   "link": "",
   "support": "",
   "cad": "",
   "note_add": "S-001 H-03: normally open, closed with key in the cylinder; joins LY (constant, X-04 15 A) to G at the Control Processing Unit (X-16), which sounds the key reminder buzzer."
  },
  {
   "id": "PT816",
   "link": "",
   "support": "",
   "cad": "",
   "note_add": "S-001 H-12 (luggage compartment light switch): single RB wire from the 5 W luggage lamp; the switch closes to body ground when the hatch opens."
  },
  {
   "id": "PT832",
   "link": "",
   "support": "",
   "cad": "",
   "note_add": "S-001 H-02: BL (from the 3.4 W glove box lamp) and a ring-terminal B to ground (X-02, X-13)."
  },
  {
   "id": "PT849",
   "link": "",
   "support": "",
   "cad": "",
   "note_add": "S-001 H-10 auto clock: 4-cavity connector B (ground), RG (illumination, light switch), LY (constant, X-04 15 A, keeps time), GY (ignition, X-04 10 A, display)."
  }
